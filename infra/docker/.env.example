# ============================================================
# ForgeOps AI — Docker Environment Variables
# SECURITY: This file is in .gitignore. NEVER commit it.
# Copy this to .env and fill in real values.
# ============================================================

# --- Gemini AI ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
FORGEOPS_METRICS_PASSWORD=replace-with-a-long-random-monitoring-password
GRAFANA_ADMIN_PASSWORD=replace-with-a-long-random-grafana-password

# --- Database ---
POSTGRES_USER=forgeops_user
POSTGRES_PASSWORD=replace_with_a_long_random_password
POSTGRES_DB=forgeops_db

# --- JWT ---
FORGEOPS_JWT_SECRET=replace_with_base64_output_of_32_random_bytes
FORGEOPS_ALLOWED_ORIGINS=http://localhost:3000
# Keep false only for local HTTP. Set true behind an HTTPS reverse proxy/load balancer.
FORGEOPS_REFRESH_COOKIE_SECURE=false
# Keep local-only by default. In AWS, bind the frontend to the host interface only
# when an HTTPS load balancer targets this instance and the security group allows
# traffic from that load balancer alone.
FRONTEND_BIND_ADDRESS=127.0.0.1
# Optional immutable GHCR images for a verified release. Keep local tags for
# normal `docker compose up --build` development.
BACKEND_IMAGE=forgeops-ai-backend:local
FRONTEND_IMAGE=forgeops-ai-frontend:local
FORGEOPS_AUTH_RATE_LIMIT=20
FORGEOPS_AI_RATE_LIMIT=60
FORGEOPS_REDIS_CACHE_ENABLED=true
FORGEOPS_DASHBOARD_CACHE_TTL=5s
REDIS_PASSWORD=replace_with_a_long_random_password

# --- Optional one-time account bootstrap (disabled by default) ---
FORGEOPS_BOOTSTRAP_ENABLED=false
FORGEOPS_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
FORGEOPS_BOOTSTRAP_ADMIN_PASSWORD=replace_with_at_least_12_characters
