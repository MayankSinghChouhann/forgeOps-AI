# ============================================================
# ForgeOps AI — Docker Environment Variables
# SECURITY: This file is in .gitignore. NEVER commit it.
# Copy this to .env and fill in real values.
# ============================================================

# --- Gemini AI ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# --- Database ---
POSTGRES_USER=forgeops_user
POSTGRES_PASSWORD=replace_with_a_long_random_password
POSTGRES_DB=forgeops_db

# --- JWT ---
FORGEOPS_JWT_SECRET=replace_with_base64_output_of_32_random_bytes
FORGEOPS_ALLOWED_ORIGINS=http://localhost:3000
FORGEOPS_AUTH_RATE_LIMIT=20
FORGEOPS_AI_RATE_LIMIT=60
FORGEOPS_REDIS_CACHE_ENABLED=true
FORGEOPS_DASHBOARD_CACHE_TTL=5s
REDIS_PASSWORD=replace_with_a_long_random_password

# --- Optional one-time account bootstrap (disabled by default) ---
FORGEOPS_BOOTSTRAP_ENABLED=false
FORGEOPS_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
FORGEOPS_BOOTSTRAP_ADMIN_PASSWORD=replace_with_at_least_12_characters
