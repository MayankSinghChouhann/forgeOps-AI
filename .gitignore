# ============================================================
# ForgeOps AI — .gitignore
# NEVER commit secrets, compiled binaries, or IDE files.
# ============================================================

# -----------------------------------------------
# Environment & Secrets (CRITICAL — NEVER COMMIT)
# -----------------------------------------------
.env
.env.*
!.env.example
*.env
infra/docker/.env

# -----------------------------------------------
# Java / Maven Build Outputs
# -----------------------------------------------
**/target/
*.class
*.jar
*.war
!**/src/main/**
!**/src/test/**
.mvn/
mvnw
mvnw.cmd

# -----------------------------------------------
# Node / Frontend Build Outputs
# -----------------------------------------------
node_modules/
**/node_modules/
dist/
**/dist/
.vite/
*.local

# -----------------------------------------------
# IDE & OS Files
# -----------------------------------------------
.idea/
*.iml
.vscode/
.DS_Store
Thumbs.db
*.suo
*.user

# -----------------------------------------------
# Docker & Compose
# -----------------------------------------------
docker-compose.override.yml

# -----------------------------------------------
# Logs
# -----------------------------------------------
*.log
logs/

# Generated test and scan reports
coverage/
playwright-report/
test-results/
zap-report/
backend-dast.log
*.tsbuildinfo
*.hprof
*.heapdump
